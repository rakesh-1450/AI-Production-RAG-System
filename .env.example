# Copy to .env and fill in. Never commit .env.
# Optional: without a key the app still works in "retrieval-only" mode.
OPENROUTER_API_KEY=

# Optional: comma-separated model list, tried in order (see openrouter.ai/models)
LLM_MODELS=openai/gpt-4o-mini,anthropic/claude-3-haiku

# Set to false on a public deployment so visitors cannot modify the knowledge base
ALLOW_UPLOADS=true
